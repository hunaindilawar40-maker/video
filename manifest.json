{
  "manifest_version": 3,
  "name": "Agnes Studio",
  "version": "1.0.0",
  "description": "Turn text prompts into short videos with the Agnes AI video API. Extension pages bypass CORS.",
  "action": {
    "default_title": "Agnes Studio",
    "default_popup": "web/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://apihub.agnes-ai.com/*"
  ]
}
